[Unit]
Description=Sync systemd-boot to the shim second-stage path
After=local-fs.target systemd-boot-update.service
Before=graphical.target
ConditionPathExists=/boot/EFI/systemd/systemd-bootx64.efi

[Service]
Type=oneshot
ExecStart=/usr/libexec/sync-shim-systemd-boot

[Install]
WantedBy=multi-user.target
